# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project Settings -> Environment Variables) for production.

# Supabase project URL and anon (public) key. Used by the PurveX Labs
# waitlist form (src/lib/waitlist.ts) and by the portal account system
# (src/lib/portal-auth.ts, /account/signup, /account/login, /pricing,
# /add-seat, /my-license).
# Find both under Project Settings -> API in your Supabase dashboard.
#
# Portal accounts are entirely separate from any PurveX product instance's
# own users -- run frontend/supabase/portal_profiles.sql once against this
# same project (SQL editor) alongside waitlist.sql.
#
# To enable "Continue with Google": Supabase dashboard -> Authentication ->
# Providers -> Google, add your OAuth client ID/secret there. No extra env
# var needed in this app for that.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe Payment Link for the paid plan (Stripe dashboard -> Payment Links
# -> create one for the PurveX paid plan's price). Used by /pricing to send
# a portal account to checkout, with client_reference_id/prefilled_email
# appended automatically. After payment, set the Payment Link's confirmation
# page to redirect to <your-site>/get-purvex?plan=paid.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=

# Second, separate Payment Link for "add one more seat" -- for a paying
# customer who hit their license's own seat cap (see /add-seat). Create it
# in Stripe dashboard -> Payment Links, same price as one seat ($49/mo).
# NEXT_PUBLIC_STRIPE_ADD_SEAT_LINK_URL is what /add-seat redirects to.
# STRIPE_ADD_SEAT_PAYMENT_LINK_ID is that same link's id (starts "plink_",
# shown on the link's own page in the dashboard) -- the webhook uses it to
# tell "new customer" and "existing customer buying another seat" apart,
# since both fire the same checkout.session.completed event type.
NEXT_PUBLIC_STRIPE_ADD_SEAT_LINK_URL=
STRIPE_ADD_SEAT_PAYMENT_LINK_ID=

# --- Stripe webhook (src/app/api/stripe-webhook/route.ts) ---
# Without these, a customer who pays gets no automated record and nobody is
# notified -- see that route's own comment for why this exists.
#
# STRIPE_SECRET_KEY: Stripe dashboard -> Developers -> API keys.
# STRIPE_WEBHOOK_SECRET: Stripe dashboard -> Developers -> Webhooks -> add
#   endpoint at <your-site>/api/stripe-webhook, listening for
#   checkout.session.completed AND invoice.paid (renewals) -> copy the
#   "Signing secret" it gives you.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard -> Project Settings -> API
# -> service_role key (NOT the anon key above -- this one bypasses Row Level
# Security, so never expose it client-side or with a NEXT_PUBLIC_ prefix).
# Needed for the webhook to mark a portal_profiles row paid server-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payment notification emails (both optional, but you want at least the
# owner one -- without it, a payment is recorded in Supabase but nobody is
# told). Sign up at resend.com (free tier, no card) for RESEND_API_KEY.
# NOTIFICATION_FROM_EMAIL needs a domain verified in Resend, or leave unset
# to send from Resend's shared onboarding@resend.dev address for now.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=
