#!/bin/bash
# Guacamole gateway: guacd, the Guacamole web app with encrypted-JSON sign-in
# only (CaseFile signs every link), and Caddy for automatic HTTPS.
set -euo pipefail

dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/casefile-gateway
cd /opt/casefile-gateway

cat > Caddyfile <<'CADDY'
{
  email ${acme_email}
}
${domain} {
  encode gzip
  reverse_proxy guacamole:8080
}
CADDY

cat > docker-compose.yml <<'COMPOSE'
services:
  guacd:
    image: guacamole/guacd:1.5.5
    restart: unless-stopped
  guacamole:
    image: guacamole/guacamole:1.5.5
    restart: unless-stopped
    depends_on: [guacd]
    environment:
      GUACD_HOSTNAME: guacd
      JSON_SECRET_KEY: ${json_key}
      WEBAPP_CONTEXT: ROOT
  caddy:
    image: caddy:2.8
    restart: unless-stopped
    depends_on: [guacamole]
    ports: ["80:80", "443:443"]
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
volumes:
  caddy_data: {}
COMPOSE

docker compose up -d
